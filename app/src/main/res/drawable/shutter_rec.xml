<?xml version="1.0" encoding="utf-8"?>
<!-- 录制中：白色大圆盘换成居中的小圆角方块（28dp），别顶到 72dp 的圆环上 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="14dp"
        android:top="14dp"
        android:right="14dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#FFFF5B5B" />
        </shape>
    </item>
</layer-list>
