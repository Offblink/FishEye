<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <org.offblink.fisheye.GlPreviewView
        android:id="@+id/edit_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/edit_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/edit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:letterSpacing="0.22"
            android:text="调色"
            android:textColor="@color/fg"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/edit_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:padding="6dp"
            android:text="保存"
            android:textColor="@color/accent"
            android:textSize="13sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/edit_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <WebView
            android:id="@+id/edit_controls"
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <View
        android:id="@+id/edit_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black"
        android:importantForAccessibility="no" />

</FrameLayout>
