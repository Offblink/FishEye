<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vid_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <TextureView
        android:id="@+id/vid_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 拖动进度条时盖在上面的「目标帧」：解码器还没 seek 到位就先看到它 -->
    <ImageView
        android:id="@+id/vid_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/vid_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:letterSpacing="0.12"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="26dp"
        android:paddingBottom="16dp"
        android:text="返回"
        android:textColor="@color/fg"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/vid_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <org.offblink.fisheye.PlayPauseView
                android:id="@+id/vid_play"
                android:layout_width="34dp"
                android:layout_height="34dp" />

            <TextView
                android:id="@+id/vid_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:letterSpacing="0.06"
                android:text="0:00 / 0:00"
                android:textColor="@color/fg_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <org.offblink.fisheye.ScrubBar
            android:id="@+id/vid_scrub"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</FrameLayout>
